<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.study.teller.mapper.EmpMapper">

    <select id="selectEmp" parameterType="string"
            resultType="com.study.teller.vo.EmpVo">
        SELECT EMP_NO, EMP_NM, BANK_CODE, BRANCH_CODE,
               PASSWD, AUTH_LV, USE_YN
          FROM TB_EMP
         WHERE EMP_NO = #{empNo}
    </select>

</mapper>